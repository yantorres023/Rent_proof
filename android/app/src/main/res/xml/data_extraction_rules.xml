<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: exclude app data from cloud backup (25 MB cap could split the
     database from its evidence files). Device-to-device transfer, which is
     local, user-initiated and copies everything together, stays allowed. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
</data-extraction-rules>
